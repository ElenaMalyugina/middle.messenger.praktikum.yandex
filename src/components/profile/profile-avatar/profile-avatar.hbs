<section class="profile__section profile-avatar profile__profile-avatar">
    <div class="profile__container">
        {{#with userData}}
            {{#if ../isEditable}}
                {{{ ProfileAvatarForm className="avatar-label" for="avatar" title="Изменить файл" name="avatar"
                    profileImg=avatar profileName=profileName
                }}}
            {{else}}
                <figure class="profile-avatar__wrapper">
                    {{{ Img className="profile-avatar__img" src=avatar alt=profileName width="130" height="130" }}}
                </figure>
            {{/if}}
            <h1 class="profile-header profile-avatar__header">{{ profileName }}</h1>
        {{/with}}
    </div>
</section>
