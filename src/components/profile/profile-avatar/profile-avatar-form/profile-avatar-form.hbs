    <label class="{{className}}" for="{{name}}" title="{{title}}">
        {{{ Img className="profile-avatar__img" src=profileImg alt=profileName width="130" height="130"}}}
        <span class="popup__text">{{text}}</span>
        <input class="visually-hidden" type="file" name="{{name}}" id="{{name}}" form="{{currentForm}}">
    </label>
</form>
