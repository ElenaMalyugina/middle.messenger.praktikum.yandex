<form errorType="avatarError" id="avatarForm" ref="form" enctype="multipart/form-data">
    <figure class="avatar-wrapper profile-avatar__wrapper">
        <label class="{{className}}" for="{{name}}" title="{{title}}">
            {{{ Img className="avatar__img" src=profileImg alt=profileName width="130" height="130"}}}
            <span class="popup__text">{{text}}</span>
            {{{ FileInput name=name id=name form=currentForm onChange=onChange ref="avatarInput" }}}
        </label>
    </figure>
    {{{ ErrorMessage className="profile-form__error form__error" ref="serverError" }}}
</form>
