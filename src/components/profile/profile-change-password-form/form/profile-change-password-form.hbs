<form action="/" className="profile-form" id="profile-form" ref="form" novalidate="novalidate">
    <div class="block-grid profile__block-grid">
        {{#with data}}
            {{{ TextRowEditable label="Старый пароль" type="password" name="old_password" id="old_password" value=old_password validators="required,password" }}}
            {{{ TextRowEditable label="Новый пароль" type="password" name="new_password" id="new_password" value=new_password validators="required,password" }}}
            {{{ TextRowEditable label="Повторите новый пароль" type="password" name="repeat_new_password" value=repeat_new_password id="repeat_new_password" validators="required,,password,repeatpassword" }}}
        {{/with}}
    </div>
    {{{ Button className="button profile-form__button" type="submit" text="Сохранить"}}}
</form>
