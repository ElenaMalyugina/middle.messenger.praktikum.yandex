<section class="profile__section profile-info profile__profile-info">
    <div class="profile__container">
        <div class="block-grid profile__block-grid">
        {{#with data}}
            {{{ TextRowBlock label="Почта" value=email }}}
            {{{ TextRowBlock label="Логин" value=login }}}
            {{{ TextRowBlock label="Имя" value=first_name }}}
            {{{ TextRowBlock label="Фамилия" value=second_name }}}
            {{{ TextRowBlock label="Имя в чате" value=display_name }}}
            {{{ TextRowBlock label="Телефон" value=phone }}}
        {{/with}}
        </div>
    </div>
</section>
