{{#with message}}
<li class="message-item {{block}}__message-item {{#if isAuthor}} message-item--self chat__message-item--self {{/if}}" tabindex="0">
    <div class="message-item__content">
        {{#if file}}
        <figure class="message-item__file-block">
            {{{ Img className="message-item__file" src=(concat "https://ya-praktikum.tech/api/v2/resources/" file.path) alt="Прикрепленная картинка" }}}
        </figure>
        {{/if}}
        {{#unless file}}
            {{{content}}}
        {{/unless}}
    </div>
    <div class="message-item__bottom">
        {{#if isCheckIcon }}
            {{{ Img src="/img/read.svg" alt=""}}}
        {{/if}}
        <time class="time message-item__time {{#if isAuthor}}message-item__time--self{{/if}}" datetime="{{time}}">{{#getTime time}}{{/getTime}}</time>
    </div>
</li>
{{/with}}

