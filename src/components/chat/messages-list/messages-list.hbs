<ul class="messages-list messages-box__messages-list">
    <li class="messages-list__button-wrapper">
        {{{ Button className="button messages-list__button" type="button" text="Загрузить еще" onClick=addOldMessages}}}
        {{{ ErrorMessage className="no-chats"}}}
    </li>
    {{#each messages as | messageItem |}}
        {{#if isChangedDate}}
            <li class="time messages-list__time">{{#getDayAndYear time}}{{/getDayAndYear}}</li>
        {{/if}}
        {{{ MessageItem message=messageItem  }}}
    {{/each}}
</ul>
