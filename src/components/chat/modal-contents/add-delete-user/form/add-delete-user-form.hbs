<form className="form" action="{{action}}" novalidate="novalidate" ref="form">
    {{{ InputBlock type="text" label="Логин" name="login" id="login" required="required" validators="required"
        onInputEmit=onInputEmit list="searchedUsers" }}}
        <datalist id="searchedUsers">
            {{#each searchedUsers as | user|}}
                <option value={{user.id}}>{{user.login}}</option>
            {{/each}}
        </datalist>
    {{{ Button className="button form-block__button form-block__button--last" type="submit" text=buttonText id="modal-user-button"}}}
</form>

