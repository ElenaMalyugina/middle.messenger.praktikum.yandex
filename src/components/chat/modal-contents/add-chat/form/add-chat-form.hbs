<form className="form" action="{{action}}" novalidate="novalidate" ref="form">
    {{{ InputBlock type="text" label="Название чата" name="title" id="title" required="required" validators="required" }}}
    {{{ ErrorMessage className="input-block__error form__error" ref="serverError"}}}
    <div class="modal__button-wrapper">
        {{{ Button className="button form-block__button form-block__button--last" type="submit" text="Создать" id="modal-user-button"}}}
        {{{ Loader className="form-block__loader-wrapper" ref="loader"}}}
    </div>
</form>

