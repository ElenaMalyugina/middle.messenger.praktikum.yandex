<dialog class="popup user-popup message-box-header__user-popup" id="user-popup" ref="popup">
    <ul class="popup__list popup-user__list">
        <li class="popup__item popup-user__item">
            <button class="extended-button popup__row" id="user-button-add">
                {{> add-user-icon}}
                <span class="popup__text">Добавить пользователя</span>
            </button>
        </li>
        <li class="popup__item popup-user__item">
            <button class="extended-button popup__row" id="user-button-delete">
                {{> delete-user-icon}}
                <span class="popup__text">Удалить пользователя</span>
            </button>
        </li>
    </ul>
</dialog>
