<form className="popup-files" action="/messenger" id="popup-form">
    <ul class="popup__list popup-files__list">
        <li class="popup__item popup-files__item">
            {{{ UploadFile className="popup-files-label popup__row" for="upload-photo" name="photo"
            icon="image-icon" text="Фото или Видео" }}}
        </li>
        <li class="popup__item popup-files__item">
            {{{ UploadFile className="popup-files-label popup__row" for="upload-file" name="file"
            icon="file-icon" text="Файл" }}}
        </li>
        <li class="popup__item popup-files__item">
            {{{ UploadFile className="popup-files-label popup__row" for="upload-location" name="location"
            icon="location-icon" text="Локация" }}}
        </li>
    </ul>
</form>
