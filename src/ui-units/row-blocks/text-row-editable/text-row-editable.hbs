<div class="text-row-block text-row-block--editable">
    <div class="text-row text-row__td text-row__td--editable text-row__label">
        {{{ Label className="input-block__label text-row__label" forEl=name text=label }}}
    </div>
    <div class="text-row text-row__td text-row__td--editable text-row__value">
        {{{
            Input className="input-block__input text-row__input"
            type=type name=name id=id value=value ref=name
            validators=validators
            onValidate=onValidate cleanValidate=cleanValidate
        }}}
    </div>
    {{{ ErrorMessage className="input-block__error text-row__error" id="js-{{name}}" ref="error" }}}
</div>


