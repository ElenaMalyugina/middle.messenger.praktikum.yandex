<div class="datalist" ref="datalist">
    <ul class="datalist__list">
        {{#each dataList as | dataItem|}}
        <li class="datalist__item">
            <button class="extended-button datalist__button" data-value="{{dataItem.value}}" data-text="{{dataItem.text}}" type="button">
                {{dataItem.text}}
            </button>
        </li>
        {{/each}}
        {{#unless dataList }}
            <li class="datalist__no-content">
                {{notFoundText}}
            </li>
        {{/unless}}
    </ul>
</div>

