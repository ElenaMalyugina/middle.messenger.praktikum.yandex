<form method="{{method}}" action="{{action}}" className="{{className}}" id="{{id}}" ref="{{ref}}" novalidate="novalidate">
    {{#with data}}
        {{{ InputBlock block="login" type="text" label="Логин" name="login" id="login" value=login validators="required" }}}
        {{{ InputBlock block="login" type="password" label="Пароль" name="password" id="password" value=password validators="required" }}}
    {{/with}}
    {{! Не ставлю валидацию по паттернам, не будем упрощать подбор }}
    {{{ Button className="button form-block__button" type="submit" text="Войти" }}}
</form>
