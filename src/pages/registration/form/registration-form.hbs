<form method="{{method}}" action="{{action}}" className="{{className}}" id="{{id}}" ref="{{ref}}" novalidate="novalidate">
    {{#with data}}
        {{{ InputBlock block="registration" type="email" label="Почта" name="email" id="email" value=email validators="required,email"}}}
        {{{ InputBlock block="registration" type="text" label="Логин" name="login" id="login" value=login validators="required,login"}}}
        {{{ InputBlock block="registration" type="text" label="Имя" name="first_name" id="first_name" value=first_name validators="required,username"}}}
        {{{ InputBlock block="registration" type="text" label="Фамилия" name="second_name" id="second_name" value=second_name validators="required,username"}}}
        {{{ InputBlock block="registration" type="text" label="Телефон" name="phone" id="phone" value=phone validators="required,phone"}}}
        {{{ InputBlock block="registration" type="password" label="Пароль" name="password" id="new_password" value=new_password validators="required,password"}}}
        {{{ InputBlock block="registration" type="password" label="Пароль (еще раз)" name="repeat_password" id="repeat_password" value=repeat_password validators="required,password,repeatpassword"}}}
    {{/with}}

    {{{ ErrorMessage className="input-block__error form__error" ref="serverError" message=regServerError }}}
    <div class="form-block__button-wrapper">
        {{{ Button className="button form-block__button" type="submit" text="Зарегистрироваться"}}}
        {{{ Loader className="form-block__loader-wrapper" ref="loader"}}}
    </div>
</form>
