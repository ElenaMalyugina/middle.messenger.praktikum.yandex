<form method="{{method}}" action="{{action}}" className="{{className}}" id="{{id}}" ref="{{ref}}" novalidate="novalidate">
    {{{ InputBlock block="registration" type="email" label="Почта" name="email" id="email" validators="required,email"}}}
    {{{ InputBlock block="registration" type="text" label="Логин" name="login" id="login" validators="required,login"}}}
    {{{ InputBlock block="registration" type="text" label="Имя" name="first_name" id="first_name" validators="required,username"}}}
    {{{ InputBlock block="registration" type="text" label="Фамилия" name="second_name" id="second_name" validators="required,username"}}}
    {{{ InputBlock block="registration" type="text" label="Телефон" name="phone" id="phone" validators="required,phone"}}}
    {{{ InputBlock block="registration" type="password" label="Пароль" name="password" id="new_password" validators="required,password"}}}
    {{{ InputBlock block="registration" type="password" label="Пароль (еще раз)" id="repeat_password" name="repeat_password" validators="required,repeatpassword"}}}
    {{{ Button className="button form-block__button" type="submit" text="Зарегистрироваться"}}}
</form>
