    "@types/jest": "^30.0.0",
    "@types/web": "^0.0.345",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "postcss": "^8.5.8",
    "postcss-extend-rule": "^4.0.0",
    "postcss-nested": "^7.0.2",
    "stylelint": "^17.5.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.3",
