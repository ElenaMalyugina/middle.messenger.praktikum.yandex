{
  "name": "middle.messenger.praktikum.yandex",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "eslint . && stylelint **/*.css && tsc --noEmit && vite build",
    "build:gh": "vite build --base=/middle.messenger.praktikum.yandex/ && cp dist/index.html dist/404.html",
